# Writes version.cpp with the git commit the code builds from and a fingerprint of
# the sources (the same code, the same fingerprint, with or without git); run on
# every build, the file is rewritten only when its text changes.
file(GLOB_RECURSE sources RELATIVE "${SOURCE_DIR}/src" "${SOURCE_DIR}/src/*.cpp" "${SOURCE_DIR}/src/*.hpp")
list(SORT sources)
set(all "")
foreach(path IN LISTS sources)
  file(SHA256 "${SOURCE_DIR}/src/${path}" digest)
  string(APPEND all "${path}${digest}")
endforeach()
string(SHA256 fingerprint "${all}")
string(SUBSTRING "${fingerprint}" 0 10 fingerprint)
set(code "code ${fingerprint}")
execute_process(COMMAND git -C "${SOURCE_DIR}" log -1 "--format=%h %cs %s" OUTPUT_VARIABLE commit RESULT_VARIABLE r1
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse --abbrev-ref HEAD OUTPUT_VARIABLE branch RESULT_VARIABLE r2
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain --untracked-files=no OUTPUT_VARIABLE dirty RESULT_VARIABLE r3
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(r1 EQUAL 0 AND r2 EQUAL 0 AND r3 EQUAL 0)
  set(local "")
  if(NOT dirty STREQUAL "")
    set(local ", + local changes")
  endif()
  set(version "commit ${commit} (branch ${branch}${local}), ${code}")
else()
  set(version "version unknown (not a git checkout), ${code}")
endif()
string(REPLACE "\\" "\\\\" version "${version}")
string(REPLACE "\"" "\\\"" version "${version}")
set(text "// Generated by cmake/version.cmake at build time.\n#include \"version.hpp\"\nconst char* nmm::build_version() { return \"${version}\"; }\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUTPUT}" "${text}")
endif()
